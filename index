<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, maximum-scale=1.0">
<title>Roasters Sort 〜極上やり込みパズル〜</title>
<style>
:root {
--bg-color: #f7f2e7;
--border-dark: #3d1e11;
--ad-height: 100px;
}
* {
box-sizing: border-box;
margin: 0;
padding: 0;
user-select: none;
-webkit-tap-highlight-color: transparent;
}
body {
font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Hiragino Kaku Gothic ProN", sans-serif;
background-color: var(--bg-color);
color: #3d1e11;
display: flex;
flex-direction: column;
align-items: center;
min-height: 100vh;
padding-bottom: calc(var(--ad-height) + 20px);
}
/* メインコンテナ */
.app-container {
width: 100%;
max-width: 420px;
display: flex;
flex-direction: column;
align-items: center;
padding: 20px 20px 0 20px;
}
/* タイトルエリア */
.title-area {
text-align: center;
margin-top: 10px;
margin-bottom: 12px;
}
.title-logo {
display: flex;
align-items: center;
justify-content: center;
gap: 8px;
}
.title-text {
font-size: 36px;
font-weight: 900;
color: #3d1e11;
letter-spacing: -0.5px;
text-shadow: 2px 2px 0px rgba(0,0,0,0.1);
}
.sub-title {
font-size: 14px;
font-weight: bold;
color: #3d1e11;
margin-top: 2px;
}
/* Sound Switch Container */
.audio-controls {
display: flex;
justify-content: center;
gap: 12px;
width: 100%;
margin-bottom: 20px;
}
.btn-audio {
background: #ffffff;
border: 3px solid var(--border-dark);
border-radius: 20px;
padding: 6px 16px;
font-size: 14px;
font-weight: 800;
color: #3d1e11;
cursor: pointer;
box-shadow: 0 4px 0 var(--border-dark);
display: flex;
align-items: center;
gap: 6px;
}
.btn-audio:active {
transform: translateY(2px);
box-shadow: 0 2px 0 var(--border-dark);
}
/* Menu Buttons */
.menu-list {
width: 100%;
display: flex;
flex-direction: column;
gap: 12px;
}
.btn-roaster {
width: 100%;
padding: 14px 16px;
border: 3.5px solid var(--border-dark);
border-radius: 28px;
font-size: 17px;
font-weight: 900;
display: flex;
align-items: center;
justify-content: center;
gap: 8px;
cursor: pointer;
box-shadow: 0 5px 0 var(--border-dark);
transition: transform 0.05s, box-shadow 0.05s;
}
.btn-roaster:active {
transform: translateY(3px);
box-shadow: 0 2px 0 var(--border-dark);
}
/* ボタンカラー（元の画像を精密再現） */
.btn-continue { background: #d36528; color: #ffffff; }
.btn-stage { background: #ffffff; color: #3d1e11; }
.btn-daily { background: #55b26b; color: #ffffff; }
.btn-time { background: #be5321; color: #ffffff; }
.btn-shop { background: #884cb0; color: #ffffff; }
.btn-stats { background: #48a68a; color: #ffffff; }
.btn-achieve { background: #ffffff; color: #3d1e11; }
.btn-bonus { background: #55b26b; color: #ffffff; }
.btn-help { background: #ffffff; color: #b8332a; }
/* Screen Management */
.screen { display: none; width: 100%; flex-direction: column; align-items: center; }
.screen.active { display: flex; }
/* --- ゲーム画面 UI --- */
.game-header {
display: flex;
justify-content: space-between;
align-items: center;
width: 100%;
padding: 12px 20px;
background: #ffffff;
border: 3.5px solid var(--border-dark);
border-radius: 25px;
font-size: 18px;
font-weight: 900;
margin-bottom: 25px;
box-shadow: 0 4px 0 var(--border-dark);
}
.bottles-area {
display: flex;
justify-content: center;
align-items: flex-end;
gap: 16px;
margin: 15px 0 30px 0;
width: 100%;
min-height: 220px;
}
.bottle {
width: 60px;
height: 190px;
border: 4px solid var(--border-dark);
border-radius: 0 0 22px 22px;
display: flex;
flex-direction: column-reverse;
align-items: center;
padding: 6px 4px;
background: rgba(255, 255, 255, 0.85);
cursor: pointer;
position: relative;
transition: transform 0.15s ease, border-color 0.15s ease;
box-shadow: inset 0 -6px 10px rgba(0,0,0,0.05), 0 4px 6px rgba(0,0,0,0.1);
}
.bottle::before {
content: '';
position: absolute;
top: -12px;
width: 44px;
height: 10px;
border: 3.5px solid var(--border-dark);
border-bottom: none;
border-radius: 6px 6px 0 0;
background: #e8ded1;
}
.bottle.selected {
border-color: #f39c12;
transform: translateY(-16px);
box-shadow: 0 12px 20px rgba(243, 156, 18, 0.3);
}
.bean-item {
width: 46px;
height: 40px;
border-radius: 50%;
margin: 2px 0;
border: 1px solid rgba(0,0,0,0.15);
box-shadow: inset -3px -3px 6px rgba(0,0,0,0.35), inset 2px 2px 4px rgba(255,255,255,0.4);
}
/* --- 1500ステージ対応 ステージ選択画面 --- */
.stage-title-text {
font-size: 22px;
font-weight: 900;
margin-bottom: 15px;
}
.stage-grid {
display: grid;
grid-template-columns: repeat(5, 1fr);
gap: 10px;
width: 100%;
height: 430px;
overflow-y: auto;
padding: 12px;
background: #ffffff;
border-radius: 25px;
border: 3.5px solid var(--border-dark);
margin-bottom: 20px;
box-shadow: 0 4px 0 var(--border-dark);
}
.stage-btn {
aspect-ratio: 1;
background: #f7f2e7;
border: 2.5px solid var(--border-dark);
border-radius: 14px;
font-weight: 900;
font-size: 13px;
cursor: pointer;
display: flex;
align-items: center;
justify-content: center;
box-shadow: 0 3px 0 var(--border-dark);
color: #3d1e11;
}
